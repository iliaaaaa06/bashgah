# =========================================================
#  تنظیمات دستیار اداری هوشمند — این فایل را به .env کپی کنید
# =========================================================

# ---------- API ----------
APP_HOST=0.0.0.0
APP_PORT=8000
# کلید مدیر برای /admin/* (هدر X-Admin-Key) — حتماً تغییر دهید
ADMIN_API_KEY=change-me-to-a-long-random-string
# دامنه‌های مجاز UI (با کاما جدا شوند)، مثلاً http://localhost:3000
CORS_ORIGINS=*

# =========================================================
#  سرور مدل — فقط همین خط را با IP سرور عوض کنید
# =========================================================
MODEL_SERVER_IP=SERVER_IP_HERE
# پورت Ollama (پیش‌فرض 11434). برای llama-server معمولاً 8080 و برای vLLM معمولاً 8000
MODEL_SERVER_PORT=11434

# ---------- LLM (سرور سازگار با OpenAI: Ollama / llama-server / vLLM) ----------
LLM_BASE_URL=http://${MODEL_SERVER_IP}:${MODEL_SERVER_PORT}/v1
LLM_API_KEY=not-needed
# نام مدل دقیقاً همان‌طور که روی سرور است (در Ollama: خروجی دستور ollama list)
LLM_MODEL=gemma4:26b
LLM_MAX_TOKENS=1024
# مدل‌های بزرگ‌تر یا اجرای بخشی روی CPU کندترند؛ زمان انتظار را بالا نگه دارید
LLM_TIMEOUT=300

# ---------- Embedding ----------
# پیش‌فرض: از همان سرور (در Ollama:  ollama pull bge-m3)
EMBEDDING_BASE_URL=http://${MODEL_SERVER_IP}:${MODEL_SERVER_PORT}/v1
EMBEDDING_API_KEY=not-needed
EMBEDDING_MODEL=bge-m3
# اگر سرور embedding ندارد: EMBEDDING_BASE_URL را خالی کنید و EMBEDDING_MODEL=BAAI/bge-m3
#   (در این حالت مدل روی همین سیستم لود می‌شود و بار اول حدود ۲ گیگ دانلود دارد)
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=16

# ---------- Vector DB / ذخیره‌سازی ----------
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=persian_docs
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50

# ---------- RAG ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
RELEVANCE_THRESHOLD=0.45

# ---------- جستجوی وب ----------
WEB_SEARCH_ENABLED=true
# duckduckgo (بدون کلید) | tavily (نیاز به کلید)
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_REGION=wt-wt

# ---------- فرانت‌اند (Streamlit) ----------
# آدرس بک‌اند FastAPI که فرانت به آن وصل می‌شود
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=8501
FRONTEND_DEFAULT_TEMPERATURE=0.2
FRONTEND_MAX_TEMPERATURE=1.5
FRONTEND_REQUEST_TIMEOUT=300
